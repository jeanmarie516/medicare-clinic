# ============================================================
# MediCare Frontend - Environment Variables
# ============================================================

# Backend API URL
VITE_API_URL=http://localhost:8080/api/v1

# WebSocket URL
VITE_WS_URL=http://localhost:8080/ws

# Application Name
VITE_APP_NAME=MediCare Clinic

# Demo Mode (true = skip real auth)
VITE_DEMO_MODE=false

# Token Refresh Interval (ms)
VITE_TOKEN_REFRESH_INTERVAL=3600000
